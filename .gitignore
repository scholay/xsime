.build/
.swiftpm/
DerivedData/

# Vendored librime runtime (fetched at build time by scripts/fetch-rime.sh)
Vendor/

*.app/
*.dSYM/

.DS_Store
._*
Thumbs.db
desktop.ini
*.xcuserstate
*.swp
*.swo
*~

# Local environment files; keep sanitized examples and templates available.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Signing material may be staged locally outside the usual build directories.
# Do not blanket-ignore PEM/key files: public certificates and fixtures may use them.
*.p12
*.pfx
*.p8
*.keychain
*.keychain-db
*.mobileprovision
*.provisionprofile
*.jks
*.keystore

# Machine-specific agent permissions; repository skills remain tracked.
/.claude/settings.local.json

# Retired root-level Pencil exploration; keep it out after removal.
/new-rime.pen

# Promotional video projects and assets are maintained outside this repository.
/platforms/ios/AppStore/promo-video/

# Raw logs stay local or in CI artifacts, including historical validation logs.
*.log
*.log.[0-9]*
*.log.gz
*.log.bz2
*.log.xz

# Acceptance screenshots and derived/duplicate images are local attachments.
# Product images, store screenshots and tests/fixtures remain versioned.
# See validation/README.md for the repository-wide attachment policy.
**/validation/**/*.png
**/validation/**/*.jpg
**/validation/**/*.jpeg
**/validation/**/*.gif
**/validation/**/*.webp
**/validation/**/*.bmp
**/validation/**/*.tif
**/validation/**/*.tiff
**/validation/**/*.heic
**/validation/**/*.avif
**/validation/**/logs/

# Raw console, event and CTest reports; written conclusions use Markdown/JSON.
**/validation/**/*.txt
**/validation/**/*.jsonl
**/validation/**/*.ndjson
**/validation/**/ctest-*.xml
**/validation/**/failed-ctest-*.xml
# These existing text files contain checksums or structured/source summaries.
!**/validation/**/SHA256SUMS*.txt
!/platforms/windows/native/validation/2026-10-07-feedback/58fc4bc-preview2/product-data.txt
!/platforms/windows/native/validation/2026-10-07-round2/product-data-current.txt
!/validation/windows-fluent-surfaces-20261018/changed-since-installed.txt

# Historical per-frame diagnostic streams, not aggregate verification reports.
/validation/community-feedback-closure-20261007/evidence/plugin-frames.json
/validation/community-feedback-closure-20261007/evidence/delete-video-analysis-buffer.json
/validation/community-feedback-closure-20261007/evidence/delete-video-analysis-idle.json

# Generated by platforms/windows/scripts/freeze-source.py for CI packaging.
/SOURCE-FILES.json
/SOURCE-COMMIT.txt
/SOURCE-SNAPSHOT.txt

# Superseded local Windows patch snapshots. Written acceptance notes stay in Git.
/validation/windows-*-2026101[78]/*.patch
/validation/windows-*-2026101[78]/*.diff
/platforms/windows/translation/%SystemDrive%/

# Local installer builds (CI produces the released pkg)
*.pkg

# Never commit the private AI endpoint/key. Only rime_ai.example.json (placeholder)
# is bundled; the real key stays in ~/Library/Rime/rime_ai.local.json on each machine.
rime_ai.local.json
rime-data/**/*.userdb*
rime-data/**/build/

# Local Python environments and tooling caches (not dependency lockfiles).
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.pyc
*.pyo

# Input-scheme packages, upstream source cache and verification harness built by
# scripts/input-schemes/scheme_build.py. The catalog in Catalog/input-schemes is committed.
/build/input-schemes/
Shared/build/
platforms/ios/RIMES.xcodeproj/-Xcc/

